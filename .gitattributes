# Normalize all text files to LF line endings on checkin.
* text=auto eol=lf

# Diff/merge as text.
*.md text
*.txt text
*.json text
*.yml text
*.yaml text

# Windows scripts keep CRLF since cmd.exe requires it.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files must never be normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.dll binary
*.exe binary
