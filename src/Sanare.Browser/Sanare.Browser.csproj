<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Sanare.Browser</RootNamespace>
    <AssemblyName>Sanare.Browser</AssemblyName>
    <IsPackable>true</IsPackable>
    <Description>Opt-in Playwright browser tier for Sanare: browser pool, page scope, wait strategies, interactions, resource blocking, and manual challenge hand-off.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sanare.Http\Sanare.Http.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The Tier 3 (browser) automation engine; see docs/features/browser-tier.md. No Central Package
      Management exists in this repo yet, so the version is pinned here, matching Sanare.Http's
      System.Threading.RateLimiting reference.
    -->
    <PackageReference Include="Microsoft.Playwright" />
  </ItemGroup>

</Project>
